{
  "name": "sky-ar",
  "version": "1.0.0",
  "description": "Live sky AR viewer — stars, planets, satellites, debris",
  "main": "index.js",
  "scripts": {
    "start": "npx http-server www -p 8080",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "build:apk": "npx cap sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/device": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}